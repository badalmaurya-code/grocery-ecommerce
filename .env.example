# MongoDB Connection URI (e.g. mongodb://localhost:27017/maurya_grocery or MongoDB Atlas URI)
MONGODB_URI="mongodb://localhost:27017/maurya_grocery"

# JWT Secret Key for authenticating users
JWT_SECRET="maurya_grocery_super_secret_jwt_key_2026"

# Razorpay Payment Gateway Credentials (Optional for live payments)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
